{
  // 按 Ctrl+Shift+B 编译当前文件。
  //
  // 只用这一个任务：MSVC 的 cl.exe。
  // 不要添加指向 D:\msys64 的 gcc/g++ 任务 —— Smart App Control 拦掉了
  // msys64 的汇编器 as.exe，那些编译器已经完全不可用。
  //
  // /source-charset:utf-8 不能省，也不能换成简写 /utf-8：
  //   前者只让 MSVC 按 UTF-8 读源码（中文能编译过），
  //   后者还会把字符串按 UTF-8 生成，而控制台是 GBK —— 中文输出会变乱码。
  "version": "2.0.0",
  "tasks": [
    {
      "label": "C/C++: cl.exe 生成活动文件 (MSVC)",
      "type": "shell",
      "command": "cmd",
      "args": [
        "/c",
        "\"D:\\Apps\\VS2022BuildTools\\VC\\Auxiliary\\Build\\vcvars64.bat\" >nul 2>&1 && cl /nologo /W4 /Zi /EHsc /std:c++17 /source-charset:utf-8 /D_CRT_SECURE_NO_WARNINGS \"${file}\" /Fe:\"${fileDirname}\\${fileBasenameNoExtension}.exe\""
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "problemMatcher": [
        "$msCompile"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "MSVC cl.exe 19.44（通过 vcvars64.bat 注入环境）"
    }
  ]
}
